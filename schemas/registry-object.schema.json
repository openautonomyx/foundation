{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openautonomyx.org/schemas/registry-object.schema.json",
  "title": "OpenAutonomyX Registry Object",
  "type": "object",
  "required": ["id", "type", "name", "version", "status", "owner", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "draft", "review", "approved", "active", "deprecated", "suspended", "revoked", "archived"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "steward": { "type": "string" },
    "source": { "type": "string" },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "governance": {
      "type": "object",
      "properties": {
        "policies": { "type": "array", "items": { "type": "string" } },
        "controls": { "type": "array", "items": { "type": "string" } },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "reviewCadence": { "type": "string" }
      },
      "additionalProperties": true
    },
    "trust": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "assertions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "relationships": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "object",
      "properties": {
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "nextReviewAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string" }
      },
      "additionalProperties": true
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
