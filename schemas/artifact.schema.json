{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openautonomyx.org/schemas/artifact.schema.json",
  "title": "OpenAutonomyX Artifact",
  "allOf": [
    { "$ref": "thing.schema.json" },
    {
      "type": "object",
      "required": ["artifactType", "title", "owner"],
      "properties": {
        "artifactType": {
          "type": "string",
          "enum": ["document", "dataset", "schema", "policy", "contract", "workflow", "model", "prompt", "report", "decision-record", "evaluation-record", "audit-record", "source-code", "configuration", "knowledge-asset", "publication"]
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "publisher": { "type": "string" },
        "license": { "type": "string" },
        "sensitivityClassification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted", "secret"]
        },
        "effectiveDate": { "type": "string", "format": "date-time" },
        "reviewDate": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "aiAssistanceDisclosure": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
